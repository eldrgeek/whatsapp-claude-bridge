# WhatsApp-Claude Bridge Configuration
# =====================================
# Copy this to .env and fill in your values

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Sandbox number

# Your phone number (only this number can use the bot)
APPROVED_PHONE_NUMBER=+1XXXXXXXXXX

# Anthropic (only needed for original API mode, not Claude Code mode)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8002

# Optional: Your name (shown in prompts)
USER_DISPLAY_NAME=YourName

# Optional: Google Drive folder for media hosting
# GOOGLE_DRIVE_DROPBOX_FOLDER_ID=your_folder_id
